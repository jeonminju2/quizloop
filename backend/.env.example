# DB
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/quizloop

# LLM
ANTHROPIC_API_KEY=sk-ant-xxxx
LLM_MODEL=claude-sonnet-4-5

# 업로드 자료 저장 경로 (로컬 개발용, 추후 S3 등으로 교체)
UPLOAD_DIR=./uploads

# 임베딩 (Voyage AI - https://dash.voyageai.com 에서 발급, 계정당 2억 토큰 무료)
VOYAGE_API_KEY=pa-xxxx
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# 인증 (JWT) - 반드시 설정할 것. 비워두면 서버 재시작마다 랜덤 시크릿이 생성되어
# 기존 로그인 토큰이 전부 무효화된다. 아래처럼 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 백그라운드 큐 (RQ + Redis) - 로컬은 기본값 그대로 두면 됨 (redis-server 필요).
# Redis가 안 떠있으면 자동으로 동기 처리로 폴백하므로 없어도 앱 자체는 동작함.
REDIS_URL=redis://localhost:6379/0
